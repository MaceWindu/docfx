<h1 id="{{id}}" data-uid="{{uid}}" class="text-break"{{#appliesToData}} data-applies-to="{{appliesToData}}"{{/appliesToData}}>
  {{>partials/title}}
  {{#sourceurl}}<a class="header-action link-secondary" title="View source" href="{{sourceurl}}"><i class="bi bi-code-slash"></i></a>{{/sourceurl}}
</h1>

<div class="facts text-secondary">
  <dl><dt>{{__global.namespace}}</dt><dd>{{{namespace.specName.0.value}}}</dd></dl>
  {{#assemblies.0}}<dl><dt>{{__global.assembly}}</dt><dd>{{#assembliesText}}{{.}}{{/assembliesText}}{{^assembliesText}}{{assemblies.0}}.dll{{/assembliesText}}</dd></dl>{{/assemblies.0}}{{#showAppliesTo}}<dl><dt>{{__global.appliesTo}}</dt><dd>{{>partials/appliesTo}}</dd></dl>{{/showAppliesTo}}
</div>

{{#variantViews.0}}
<div class="api-contents">
<div class="api-content" data-applies-to="{{primaryAppliesToData}}">
{{/variantViews.0}}
{{>partials/class.content}}
{{#variantViews.0}}
</div>
{{/variantViews.0}}
{{#variantViews}}
<div class="api-content" data-applies-to="{{appliesToData}}" data-search-ignore hidden>
{{>partials/class.content}}
</div>
{{/variantViews}}
{{#variantViews.0}}
</div>
{{/variantViews.0}}
{{>partials/apiVariants}}
