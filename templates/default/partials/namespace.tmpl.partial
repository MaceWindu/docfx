<h1 id="{{id}}" data-uid="{{uid}}" class="text-break">{{>partials/title}}</h1>
<div class="markdown level0 summary">{{{summary}}}</div>
<div class="markdown level0 conceptual">{{{conceptual}}}</div>
<div class="markdown level0 remarks">{{{remarks}}}</div>
{{#children}}
  <h3 id="{{id}}">{{>partials/namespaceSubtitle}}</h3>
  {{#children}}
    <h4{{#appliesToData}} data-applies-to="{{appliesToData}}"{{/appliesToData}}><xref uid="{{uid}}" altProperty="fullName" displayProperty="name"/>{{#showAppliesToBadge}} <span class="applies-to">{{>partials/appliesTo}}</span>{{/showAppliesToBadge}}</h4>
    <section>{{{summary}}}</section>
  {{/children}}
{{/children}}
