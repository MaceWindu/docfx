<h1 id="{{id}}" data-uid="{{uid}}" class="text-break"{{#appliesToData}} data-applies-to="{{appliesToData}}"{{/appliesToData}}>{{>partials/title}}</h1>
<div class="markdown level0 summary">{{{summary}}}</div>
<div class="markdown level0 conceptual">{{{conceptual}}}</div>
<div class="markdown level0 remarks">{{{remarks}}}</div>

{{#children}}
  <h3 id="{{id}}">{{>partials/namespaceSubtitle}}</h3>
  {{#children}}
  <dl class="jumplist"{{#appliesToData}} data-applies-to="{{appliesToData}}"{{/appliesToData}}>
    <dt><xref uid="{{uid}}" altProperty="fullName" displayProperty="name"/>{{#showAppliesToBadge}} <span class="applies-to ms-2 fw-normal text-body-secondary">{{>partials/appliesTo}}</span>{{/showAppliesToBadge}}</dt>
    <dd>{{{summary}}}</dd>
  </dl>
  {{/children}}
{{/children}}
