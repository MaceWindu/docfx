{{#variants.0}}
<h5 class="api-variants-heading">{{__global.inOtherFrameworks}}</h5>
{{/variants.0}}
{{#variants}}
<div class="api-variant" data-applies-to="{{appliesToData}}">
  <h6 class="api-variant-label">{{>partials/appliesTo}}</h6>
  {{#summary}}<div class="markdown summary">{{{summary}}}</div>{{/summary}}
  {{#syntax}}
  <div class="codewrapper">
    <pre><code class="lang-csharp hljs">{{syntax.content.0.value}}</code></pre>
  </div>
  {{/syntax}}
  {{#inheritance.0}}
  <div class="inheritance">
    <h5>{{__global.inheritance}}</h5>
    {{#inheritance}}
    <div>{{{specName.0.value}}}</div>
    {{/inheritance}}
  </div>
  {{/inheritance.0}}
  {{#remarks}}<div class="markdown remarks">{{{remarks}}}</div>{{/remarks}}
</div>
{{/variants}}
